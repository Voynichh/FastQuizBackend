DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-dev-only
DATABASE_URL=postgres://quiz:quiz@localhost:5432/fastquiz
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
QUIZ_QUESTION_COUNT=20
QUIZ_TIME_LIMIT_MS=5000
QUIZ_GRACE_MS=500
LEADERBOARD_SIZE=10
QUIZ_MIN_PLAUSIBLE_AVG_MS=700
# Rate limit yalnızca gerçek bağlantı IP'sini kullanır. Güvenilir bir ters proxy arkasına
# konulursa gerçek proxy sayısını verin (varsayılan 0 = X-Forwarded-For yok sayılır).
NUM_PROXIES=0
